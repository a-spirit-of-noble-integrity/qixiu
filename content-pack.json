  "modules": [
    {
      "id": "start",
      "title": "小白第一课",
      "subtitle": "零基础进车间，先搞懂这 6 节",
      "icon": "play",
      "color": "#12B76A",
      "lessons": [
        {
          "id": "start-01",
          "title": "汽修是干什么的",
          "minutes": 5,
          "blocks": [
            {
              "t": "p",
              "x": "汽修说白了就一件事：<b>让出问题的车恢复正常，让正常的车别出问题</b>。前者叫修，后者叫养，两个都得会。"
            },
            {
              "t": "pic",
              "kind": "workshop",
              "cap": "车间里的工作分两大类：修故障、做保养。"
            },
            {
              "t": "h",
              "x": "修：车坏了，找原因、换件、验证"
            },
            {
              "t": "p",
              "x": "客户说“车抖”“打不着”“漏油”，你不能上来就换件。先问清楚：<b>什么时候开始的、什么情况下出现、最近动过什么</b>，这三句话能省一半弯路。"
            },
            {
              "t": "p",
              "x": "找到原因再动手，换完件要路试验证——故障现象消失了，才算修好。只换件不验证，返工是迟早的事。"
            },
            {
              "t": "h",
              "x": "养：没坏的车，定期保养"
            },
            {
              "t": "p",
              "x": "机油、机滤、空滤、刹车片、轮胎、电瓶，这些都是消耗品。<b>保养就是在东西彻底坏掉之前换掉它</b>，比修便宜得多。"
            },
            {
              "t": "kv",
              "items": [
                [
                  "修",
                  "车坏了再处理，考的是找原因"
                ],
                [
                  "养",
                  "没坏先保养，考的是细心和流程"
                ]
              ]
            },
            {
              "t": "tip",
              "x": "刚入行别急着学“修”，先把保养流程练熟。保养活儿多、流程固定，是学徒最快上手、也最快被师傅信任的活。"
            },
            {
              "t": "note",
              "title": "一句话记住",
              "x": "修是治病，养是体检。会养车的人，才有资格谈修车。"
            }
          ],
          "quiz": [
            {
              "q": "学徒刚进车间，师傅最可能先让你干什么？",
              "options": [
                "直接上手修发动机故障",
                "先练熟保养流程",
                "先学电脑编程匹配",
                "先去前台接待客户"
              ],
              "answer": 1,
              "explain": "保养流程固定、活儿多，最适合学徒练手，也最快建立信任。修疑难故障要先把基础打牢。"
            }
          ]
        },
        {
          "id": "start-02",
          "title": "学徒第一周怎么过",
          "minutes": 5,
          "blocks": [
            {
              "t": "p",
              "x": "第一周别想着“学技术”，你的任务就三个：<b>认人、认地方、认规矩</b>。这三样认全了，师傅才敢把活儿交给你。"
            },
            {
              "t": "pic",
              "kind": "toolbox",
              "cap": "第一周先认工具柜：东西放哪、谁负责、借了怎么还。"
            },
            {
              "t": "h",
              "x": "第一天：眼睛看，嘴勤快"
            },
            {
              "t": "p",
              "x": "跟着师傅看他怎么做，工具递得及时、地上的油擦干净、拆下来的螺丝按顺序摆好。<b>学徒的第一本事不是手快，是眼里有活</b>。"
            },
            {
              "t": "p",
              "x": "不懂就问，但要挑时候：师傅手上正忙、车正举着的时候别打断，等他空下来再问，师傅更愿意讲。"
            },
            {
              "t": "h",
              "x": "第二天起：记笔记"
            },
            {
              "t": "p",
              "x": "每天下班花 10 分钟记三条：今天学了什么、哪个步骤没看懂、明天想问什么。<b>光靠脑子记，三天就忘光</b>，本子才是你的。"
            },
            {
              "t": "kv",
              "items": [
                [
                  "第一周目标",
                  "认全工具、记住车间规矩、会做一次完整保养打下手"
                ],
                [
                  "千万别干",
                  "不懂装懂、擅自动车、把客户的车当练手"
                ]
              ]
            },
            {
              "t": "tip",
              "x": "每天第一个到、最后一个走不是拍马屁，是给自己争取多看多问的时间。师傅都看在眼里。"
            },
            {
              "t": "warn",
              "title": "红线",
              "x": "没师傅点头，别单独动车、别单独举升、别单独路试。出事了你担不起。"
            }
          ],
          "quiz": [
            {
              "q": "学徒第一周最重要的事是什么？",
              "options": [
                "学会修发动机",
                "认人、认地方、认规矩",
                "学会跟客户谈价",
                "学会电脑诊断仪所有功能"
              ],
              "answer": 1,
              "explain": "第一周先认人、认地方、认规矩，师傅放心了才会把活儿交给你。技术是后面一步一步学的。"
            }
          ]
        },
        {
          "id": "start-03",
          "title": "车间规矩与安全",
          "minutes": 6,
          "blocks": [
            {
              "t": "p",
              "x": "车间里所有的规矩，背后都是一条人命或者一次大修。<b>规矩不是师傅为难你，是前人交学费换来的</b>。"
            },
            {
              "t": "pic",
              "kind": "workshop",
              "cap": "进车间先看一圈：灭火器在哪、急救箱在哪、逃生通道在哪。"
            },
            {
              "t": "h",
              "x": "三条铁规矩"
            },
            {
              "t": "ul",
              "items": [
                "车底作业：举升机必须上保险锁，光靠液压撑着不准钻车底。",
                "热车作业：排气管、水箱盖、机油都烫，拆之前先等凉。",
                "电瓶作业：拆先拆负极，装最后装负极，扳手别同时碰正极和车身。"
              ]
            },
            {
              "t": "p",
              "x": "衣服也有讲究：别穿宽松的、带绳子的衣服，袖口扎紧，长头发扎起来。<b>转动的皮带不认人，卷进去就是大事</b>。"
            },
            {
              "t": "h",
              "x": "油和火"
            },
            {
              "t": "p",
              "x": "汽油蒸气比空气重，会贴着地面飘，遇到明火、电火花就着。车间里别抽烟，擦油的抹布别乱堆，用完放进带盖的铁桶。"
            },
            {
              "t": "warn",
              "title": "出事前兆",
              "x": "闻到汽油味、看到地上有油渍、听到异响，先停手、告诉师傅，别自己硬撑着干。"
            },
            {
              "t": "note",
              "title": "记住",
              "x": "手不放在会动的东西上，人不钻没有支撑的车底，热车不开盖，拆电瓶先拆负极。"
            }
          ],
          "quiz": [
            {
              "q": "车已经用举升机顶起来了，你要钻到车底干活，第一件事是？",
              "options": [
                "直接钻进去，动作快点",
                "确认举升机上了保险锁",
                "先把轮胎拆了",
                "让别人帮你扶着车"
              ],
              "answer": 1,
              "explain": "液压系统可能泄压，必须等保险锁锁死再进车底。这是车间里的铁规矩。"
            }
          ]
        },
        {
          "id": "start-04",
          "title": "认识常用工具",
          "minutes": 6,
          "blocks": [
            {
              "t": "p",
              "x": "汽修工具看着多，常用的就三类：<b>拧的、量的、撬的</b>。先认这三类，别的以后慢慢加。"
            },
            {
              "t": "pic",
              "kind": "wrench",
              "cap": "扳手、套筒、扭力扳手是每天摸得最多的三样。"
            },
            {
              "t": "h",
              "x": "拧的：扳手和套筒"
            },
            {
              "t": "p",
              "x": "开口扳手、梅花扳手、套筒、棘轮扳手。记住一条：<b>螺丝多大，用多大的工具，宁可换一件，不能硬凑</b>，滑了丝更麻烦。"
            },
            {
              "t": "p",
              "x": "扭力扳手是用来“拧到规定力矩”的，比如轮胎螺丝、缸盖螺丝。凭手感拧，轻了会松，重了会断。"
            },
            {
              "t": "h",
              "x": "量的：万用表、胎压表、游标卡尺"
            },
            {
              "t": "p",
              "x": "万用表量电压、电阻、通断，是查电路的眼睛；胎压表每次保养都要用；游标卡尺量刹车片厚度和零件尺寸。"
            },
            {
              "t": "kv",
              "items": [
                [
                  "每天必用",
                  "套筒、扳手、螺丝刀、万用表"
                ],
                [
                  "用完必须",
                  "擦干净、放回原位，少一件立刻说"
                ]
              ]
            },
            {
              "t": "tip",
              "x": "借工具要登记、还工具要当面点数。工具丢了是小事，掉在发动机舱里没发现是大事。"
            },
            {
              "t": "warn",
              "title": "别干的事",
              "x": "工具当锤子用、拿错尺寸硬拧、把工具落在车里。修完车绕车一圈、打开机盖看一眼，养成习惯。"
            }
          ],
          "quiz": [
            {
              "q": "轮胎螺丝、缸盖螺丝这种有规定力矩的，应该用什么工具拧？",
              "options": [
                "普通扳手，凭手感拧紧就行",
                "扭力扳手，拧到规定力矩",
                "电动扳手，打到打不动为止",
                "锤子敲紧"
              ],
              "answer": 1,
              "explain": "有规定力矩的螺丝必须用扭力扳手，轻了会松、重了会断，凭手感不准。"
            }
          ]
        },
        {
          "id": "start-05",
          "title": "怎么看一台车",
          "minutes": 5,
          "blocks": [
            {
              "t": "p",
              "x": "师傅看一台车，30 秒就能说出个大概：<b>绕一圈、听声音、看仪表、闻味道</b>。你照着这个顺序练，很快也能看出来。"
            },
            {
              "t": "pic",
              "kind": "systems",
              "cap": "一台车分四大块：发动机、底盘、车身、电器。看车先分块，别一上来就盯着一个地方。"
            },
            {
              "t": "h",
              "x": "绕一圈：先看外面"
            },
            {
              "t": "p",
              "x": "轮胎瘪不瘪、花纹磨得匀不匀，地上有没有油渍水渍，车身有没有剐蹭和锈。地上那滩东西的颜色和位置，往往就是故障的第一条线索。"
            },
            {
              "t": "h",
              "x": "打火：听声音、看仪表"
            },
            {
              "t": "p",
              "x": "启动顺不顺、怠速稳不稳、有没有异响；仪表上有没有故障灯亮，机油灯、水温灯亮着就别大脚轰油门。"
            },
            {
              "t": "kv",
              "items": [
                [
                  "地上有黑色油渍",
                  "可能漏机油或变速箱油"
                ],
                [
                  "地上有绿色/粉色水渍",
                  "可能漏冷却液"
                ],
                [
                  "排气管冒蓝烟",
                  "可能烧机油"
                ]
              ]
            },
            {
              "t": "tip",
              "x": "看车先问车主：什么时候开始的、什么情况下出现、最近修过什么。这三个问题，比你先拆半小时都有用。"
            },
            {
              "t": "note",
              "title": "小白别急",
              "x": "看不出来很正常，先把“看”的流程练成习惯，判断是后面几百台车练出来的。"
            }
          ],
          "quiz": [
            {
              "q": "客户说车底地上有一滩绿色水渍，最可能是什么问题？",
              "options": [
                "漏机油",
                "漏冷却液（防冻液）",
                "漏刹车油",
                "漏汽油"
              ],
              "answer": 1,
              "explain": "冷却液通常是绿色或粉色，地上出现这种颜色的水渍，多半是冷却系统在漏。"
            }
          ]
        },
        {
          "id": "start-06",
          "title": "小白到大佬学习路线图",
          "minutes": 5,
          "blocks": [
            {
              "t": "p",
              "x": "汽修这行没有捷径，但有路线。照着路线走，<b>三年能独当一面，五年能带徒弟</b>；瞎走，十年还是换机油的。"
            },
            {
              "t": "pic",
              "kind": "systems",
              "cap": "路线就四级：入门 → 进阶 → 熟手 → 大佬，App 首页就是按这个分的。"
